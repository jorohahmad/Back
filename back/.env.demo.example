# انسخ هذا الملف إلى .env على سيرفر النسخة التجريبية ثم: php artisan key:generate
APP_NAME="Musical Instruments"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# رابط الباك كما يراه المتصفح (رابط Cloudflare Tunnel) - تُبنى عليه روابط الصور
APP_URL=https://api.your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ⚠️ قاعدة بيانات منفصلة خاصة بالديمو (DemoSeeder يمسح كل بياناتها يومياً)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=instruments_demo
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# الإيميلات لا تُرسل فعلياً في الديمو (تُكتب في اللوغ فقط)
MAIL_MAILER=log

# ===== النسخة التجريبية =====
DEMO_MODE=true
DEMO_EMAIL=demo.admin@gmail.com
# رابط الداشبورد على Cloudflare Pages (يمكن وضع أكثر من رابط مفصولة بفاصلة)
CORS_ALLOWED_ORIGINS=https://your-dashboard.pages.dev
# اختياري: للسماح بروابط المعاينة مثل https://abc123.your-dashboard.pages.dev
CORS_ALLOWED_ORIGINS_PATTERN='#^https://[a-z0-9-]+\.your-dashboard\.pages\.dev$#'
